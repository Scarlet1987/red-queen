{
  "name": "red-queen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/check-runtime.ts && vite",
    "build": "node scripts/check-runtime.ts && vite build && node scripts/postbuild.mjs && node scripts/build-offline.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/slow/*.test.ts",
    "test:fast": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run cosg -- .",
    "check:fast": "npm run typecheck && npm run test:fast && npm run cosg -- .",
    "gate": "node scripts/deploy-gate.ts",
    "release": "npm run build && npm run gate",
    "smoke": "node scripts/smoke.ts",
    "release:log": "node scripts/release-log.ts",
    "release:check": "node scripts/release-log.ts --verify",
    "offline": "node scripts/check-runtime.ts && node scripts/build-offline.ts",
    "install:red-queen": "node scripts/red-queen.ts",
    "covers": "node scripts/make-covers.ts",
    "directory": "node scripts/build-directory.ts",
    "size": "node scripts/check-size.ts",
    "cosg": "node scripts/cosg.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "hono": "^4.13.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
